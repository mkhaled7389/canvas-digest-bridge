{
  "manifest_version": 3,
  "name": "Canvas Compass",
  "version": "0.4.1",
  "description": "ASU Canvas deadlines, course filters, adaptable themes, and optional Google Calendar sync.",
  "permissions": [
    "alarms",
    "downloads",
    "notifications",
    "storage",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://canvas.asu.edu/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://canvas.asu.edu/*"
      ],
      "js": [
        "canvas-session.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Canvas Compass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://api.pushover.net/*",
    "https://www.googleapis.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "oauth2": {
    "client_id": "572396126840-plhs6fafiornv2jpk8qm7o3qa2r7lmkq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.app.created"
    ]
  }
}
